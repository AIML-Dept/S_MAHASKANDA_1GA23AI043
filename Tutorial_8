from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator


# =========================================================
# GENERALIZED DEUTSCH-JOZSA ALGORITHM
# =========================================================

def deutsch_jozsa(n, oracle_type="balanced"):

    # -----------------------------------------------------
    # Create circuit
    # n input qubits + 1 ancilla
    # -----------------------------------------------------

    qc = QuantumCircuit(n + 1, n)

    ancilla = n

    # -----------------------------------------------------
    # Prepare ancilla in |-> state
    # -----------------------------------------------------

    qc.x(ancilla)
    qc.h(ancilla)

    # -----------------------------------------------------
    # Put input qubits into superposition
    # -----------------------------------------------------

    for i in range(n):
        qc.h(i)

    # -----------------------------------------------------
    # Oracle
    # -----------------------------------------------------

    if oracle_type == "constant":

        # f(x) = 0
        # No operation required

        pass

    elif oracle_type == "balanced":

        # Balanced parity function:
        #
        # f(x) = x0 XOR x1 XOR ... XOR xn
        #
        # Implement with CNOT gates.

        for i in range(n):
            qc.cx(i, ancilla)

    else:

        raise ValueError(
            "oracle_type must be 'constant' or 'balanced'"
        )

    # -----------------------------------------------------
    # Apply Hadamards again
    # -----------------------------------------------------

    for i in range(n):
        qc.h(i)

    # -----------------------------------------------------
    # Measurement
    # -----------------------------------------------------

    for i in range(n):
        qc.measure(i, i)

    return qc


# =========================================================
# USER PARAMETERS
# =========================================================

n = 4

oracle_type = "balanced"

# Try:
# n = 2
# n = 3
# n = 4
# n = 5

# Try:
# oracle_type = "constant"
# oracle_type = "balanced"


# =========================================================
# CREATE CIRCUIT
# =========================================================

qc = deutsch_jozsa(
    n=n,
    oracle_type=oracle_type
)


# =========================================================
# DISPLAY CIRCUIT
# =========================================================

print("\nDeutsch-Jozsa Circuit")
print("=====================")
print(f"Number of input qubits : {n}")
print(f"Oracle type            : {oracle_type}")

print("\nCircuit:")
print(qc.draw(output="text"))

# Plot circuit
qc.draw(output="mpl")


# =========================================================
# SIMULATION
# =========================================================

simulator = AerSimulator()

job = simulator.run(
    qc,
    shots=1024
)

result = job.result()

counts = result.get_counts()


# =========================================================
# DISPLAY RESULTS
# =========================================================

print("\nMeasurement Results:")
print(counts)


# =========================================================
# CLASSIFICATION
# =========================================================

if len(counts) == 1:

    measured_result = list(counts.keys())[0]

    if measured_result == "0" * n:

        print("\nClassification: CONSTANT")

    else:

        print("\nClassification: BALANCED")

else:

    print("\nUnexpected result.")

