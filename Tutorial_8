import random

from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator


# =========================================================
# RANDOM BALANCED FUNCTION
# =========================================================

def generate_random_balanced_function(n):

    total_inputs = 2 ** n

    # All possible input states
    inputs = list(range(total_inputs))

    # Randomly select exactly half as f(x)=1
    ones = random.sample(
        inputs,
        total_inputs // 2
    )

    ones.sort()

    return ones


# =========================================================
# CREATE ORACLE
# =========================================================

def create_balanced_oracle(n, ones):

    qc = QuantumCircuit(n + 1)

    ancilla = n

    # -----------------------------------------------------
    # For every input where f(x)=1,
    # apply a multi-controlled X gate.
    # -----------------------------------------------------

    for value in ones:

        binary = format(value, f"0{n}b")

        # -------------------------------------------------
        # Convert zero-controls into one-controls
        # -------------------------------------------------

        for i, bit in enumerate(binary):

            if bit == "0":
                qc.x(i)

        # -------------------------------------------------
        # Multi-controlled X
        # -------------------------------------------------

        qc.mcx(
            list(range(n)),
            ancilla
        )

        # -------------------------------------------------
        # Undo zero-control conversion
        # -------------------------------------------------

        for i, bit in enumerate(binary):

            if bit == "0":
                qc.x(i)

    return qc


# =========================================================
# DEUTSCH-JOZSA CIRCUIT
# =========================================================

def create_deutsch_jozsa_circuit(n, oracle):

    qc = QuantumCircuit(
        n + 1,
        n
    )

    ancilla = n

    # -----------------------------------------------------
    # Ancilla -> |1>
    # -----------------------------------------------------

    qc.x(ancilla)

    # -----------------------------------------------------
    # Ancilla -> |->
    # -----------------------------------------------------

    qc.h(ancilla)

    # -----------------------------------------------------
    # Input superposition
    # -----------------------------------------------------

    for i in range(n):
        qc.h(i)

    # -----------------------------------------------------
    # Append oracle
    # -----------------------------------------------------

    qc.compose(
        oracle,
        inplace=True
    )

    # -----------------------------------------------------
    # Hadamard on input qubits
    # -----------------------------------------------------

    for i in range(n):
        qc.h(i)

    # -----------------------------------------------------
    # Measurement
    # -----------------------------------------------------

    for i in range(n):
        qc.measure(i, i)

    return qc


# =========================================================
# PARAMETERS
# =========================================================

n = 3

# Try:
# n = 2
# n = 3
# n = 4
# n = 5


# =========================================================
# GENERATE RANDOM BALANCED FUNCTION
# =========================================================

ones = generate_random_balanced_function(n)


print("\nRandom Balanced Function")
print("========================")

print(f"Number of input qubits: {n}")

print(
    f"Total possible inputs: {2 ** n}"
)

print(
    f"Number of f(x)=1 inputs: {len(ones)}"
)

print(
    f"Number of f(x)=0 inputs: "
    f"{2 ** n - len(ones)}"
)

print("\nInputs for which f(x)=1:")

for value in ones:

    print(
        format(value, f"0{n}b"),
        "-> 1"
    )


# =========================================================
# CREATE RANDOM ORACLE
# =========================================================

oracle = create_balanced_oracle(
    n,
    ones
)


# =========================================================
# CREATE COMPLETE DEUTSCH-JOZSA CIRCUIT
# =========================================================

qc = create_deutsch_jozsa_circuit(
    n,
    oracle
)


# =========================================================
# DISPLAY CIRCUIT
# =========================================================

print("\nDeutsch-Jozsa Circuit:")
print(qc.draw(output="text"))

# Plot circuit
qc.draw(output="mpl")


# =========================================================
# SIMULATE
# =========================================================

simulator = AerSimulator()

job = simulator.run(
    qc,
    shots=1024
)

result = job.result()

counts = result.get_counts()


# =========================================================
# DISPLAY RESULTS
# =========================================================

print("\nMeasurement Results:")
print(counts)


# =========================================================
# VERIFY CLASSIFICATION
# =========================================================

if len(counts) == 1:

    result_bit = list(counts.keys())[0]

    if result_bit == "0" * n:

        print(
            "\nERROR: Algorithm classified "
            "the random function as CONSTANT."
        )

    else:

        print(
            "\nSUCCESS!"
        )

        print(
            "Random balanced oracle "
            "correctly classified as BALANCED."
        )

        print(
            "Measured result:",
            result_bit
        )

else:

    print(
        "\nUnexpected measurement result."
    )
