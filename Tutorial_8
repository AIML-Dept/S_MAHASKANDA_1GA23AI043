from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator

# ---------------------------------------------------------
# 1. Create Deutsch-Jozsa circuit
# ---------------------------------------------------------

n = 3

# n input qubits + 1 output/ancilla qubit
qc = QuantumCircuit(n + 1, n)

# ---------------------------------------------------------
# 2. Prepare ancilla in |1>
# ---------------------------------------------------------

qc.x(n)
qc.h(n)

# ---------------------------------------------------------
# 3. Put input qubits into superposition
# ---------------------------------------------------------

for i in range(n):
    qc.h(i)

# ---------------------------------------------------------
# 4. CONSTANT ORACLE
# f(x) = 0 for every x
#
# Since f(x)=0, the oracle does nothing.
# ---------------------------------------------------------

# No gates are required for constant-0 oracle.

# ---------------------------------------------------------
# 5. Apply Hadamard gates again to input qubits
# ---------------------------------------------------------

for i in range(n):
    qc.h(i)

# ---------------------------------------------------------
# 6. Measure input qubits
# ---------------------------------------------------------

for i in range(n):
    qc.measure(i, i)

# ---------------------------------------------------------
# 7. Plot circuit
# ---------------------------------------------------------

print("Deutsch-Jozsa Circuit:")
print(qc.draw(output="text"))

# Optional matplotlib circuit
qc.draw(output="mpl")

# ---------------------------------------------------------
# 8. Run simulation
# ---------------------------------------------------------

simulator = AerSimulator()

job = simulator.run(qc, shots=1024)
result = job.result()
counts = result.get_counts()

print("\nMeasurement Results:")
print(counts)

# ---------------------------------------------------------
# 9. Verify result
# ---------------------------------------------------------

if list(counts.keys()) == ["000"]:
    print("\nSUCCESS: Constant function detected.")
    print("Deutsch-Jozsa result = 000")
else:
    print("\nUnexpected result.")


