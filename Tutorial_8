import matplotlib.pyplot as plt

# ---------------------------------------------------------
# Values of n
# ---------------------------------------------------------

n_values = list(range(2, 11))

# ---------------------------------------------------------
# Classical worst-case query count
#
# 2^(n-1) + 1
# ---------------------------------------------------------

classical_queries = [
    2 ** (n - 1) + 1
    for n in n_values
]

# ---------------------------------------------------------
# Quantum Deutsch-Jozsa query count
# ---------------------------------------------------------

quantum_queries = [
    1
    for n in n_values
]


# ---------------------------------------------------------
# Print values
# ---------------------------------------------------------

print("Query Complexity Comparison")
print("===========================")

for n, classical, quantum in zip(
    n_values,
    classical_queries,
    quantum_queries
):

    print(
        f"n = {n:2d} | "
        f"Classical = {classical:4d} | "
        f"Quantum = {quantum}"
    )


# ---------------------------------------------------------
# Plot
# ---------------------------------------------------------

plt.figure(figsize=(10, 6))

plt.plot(
    n_values,
    classical_queries,
    marker="o",
    label="Classical Worst Case"
)

plt.plot(
    n_values,
    quantum_queries,
    marker="s",
    label="Quantum Deutsch-Jozsa"
)

plt.xlabel("Number of Input Qubits (n)")
plt.ylabel("Number of Oracle Queries")

plt.title(
    "Classical vs Quantum Query Complexity"
)

plt.xticks(n_values)

plt.grid(True)
plt.legend()

plt.tight_layout()

plt.show()

