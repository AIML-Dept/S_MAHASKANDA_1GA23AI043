from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator

# ---------------------------------------------------------
# 1. Number of input qubits
# ---------------------------------------------------------

n = 3

# n input qubits + 1 ancilla
qc = QuantumCircuit(n + 1, n)

ancilla = n

# ---------------------------------------------------------
# 2. Prepare ancilla |1> -> |-> using X and H
# ---------------------------------------------------------

qc.x(ancilla)
qc.h(ancilla)

# ---------------------------------------------------------
# 3. Put input qubits into superposition
# ---------------------------------------------------------

for i in range(n):
    qc.h(i)

# ---------------------------------------------------------
# 4. BALANCED PARITY ORACLE
#
# f(x0,x1,x2) = x0 XOR x1 XOR x2
#
# Implement using CNOTs
# ---------------------------------------------------------

for i in range(n):
    qc.cx(i, ancilla)

# ---------------------------------------------------------
# 5. Apply Hadamards to input qubits
# ---------------------------------------------------------

for i in range(n):
    qc.h(i)

# ---------------------------------------------------------
# 6. Measure input qubits
# ---------------------------------------------------------

for i in range(n):
    qc.measure(i, i)

# ---------------------------------------------------------
# 7. Display circuit
# ---------------------------------------------------------

print("Deutsch-Jozsa Balanced Parity Circuit:")
print(qc.draw(output="text"))

# Plot circuit
qc.draw(output="mpl")

# ---------------------------------------------------------
# 8. Run simulation
# ---------------------------------------------------------

simulator = AerSimulator()

job = simulator.run(qc, shots=1024)
result = job.result()
counts = result.get_counts()

print("\nMeasurement Results:")
print(counts)

# ---------------------------------------------------------
# 9. Verify non-zero result
# ---------------------------------------------------------

for bitstring, count in counts.items():

    if bitstring != "000":
        print("\nSUCCESS!")
        print("Balanced function detected.")
        print("Non-zero measurement:", bitstring)
        break
else:
    print("\nERROR: Only 000 was measured.")

