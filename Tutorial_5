import math
from scipy.stats import chisquare
from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator

simulator = AerSimulator()
shots = 1000

def quantum_bits(n):
    qc = QuantumCircuit(1, 1)
    qc.h(0)
    qc.measure(0, 0)

    compiled = transpile(qc, simulator)
    result = simulator.run(compiled, shots=n).result()
    counts = result.get_counts()

    return [counts.get("0", 0), counts.get("1", 0)]

# Quantum source: test against an unbiased distribution.
q_counts = quantum_bits(shots)
q_stat, q_p = chisquare(q_counts, f_exp=[shots / 2, shots / 2])

# Biased classical source with P(1)=0.60.
biased_ones = sum(1 for _ in range(shots) if __import__("random").random() < 0.60)
biased_counts = [shots - biased_ones, biased_ones]
b_stat, b_p = chisquare(biased_counts, f_exp=[shots / 2, shots / 2])

print("Quantum counts:", q_counts)
print("Quantum chi-square:", q_stat, "p-value:", q_p)

print("Biased classical counts:", biased_counts)
print("Biased classical chi-square:", b_stat, "p-value:", b_p)

alpha = 0.05
print("Quantum conclusion:", "Reject H0" if q_p < alpha else "Do not reject H0")
print("Biased classical conclusion:", "Reject H0" if b_p < alpha else "Do not reject H0")


