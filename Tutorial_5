import math
from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator

simulator = AerSimulator()

shots = 5000

# In a simulation, choose an unknown angle only to generate data.
# The estimator below does not use this value.
hidden_theta = math.radians(60)

qc = QuantumCircuit(1, 1)
qc.ry(hidden_theta, 0)
qc.measure(0, 0)

compiled = transpile(qc, simulator)
result = simulator.run(compiled, shots=shots).result()
counts = result.get_counts()

n1 = counts.get("1", 0)
p1 = n1 / shots

# For Ry(theta)|0>, P(1) = sin^2(theta/2).
theta_est = 2 * math.asin(math.sqrt(p1))
theta_est_deg = math.degrees(theta_est)

print("Counts:", counts)
print("Estimated P(1):", p1)
print("Estimated rotation angle (degrees):", theta_est_deg)


