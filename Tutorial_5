from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator

simulator = AerSimulator()

# Create the Bell state (|00> + |11>) / sqrt(2).
qc = QuantumCircuit(2, 1)
qc.h(0)
qc.cx(0, 1)

# Measure only qubit 0.
qc.measure(0, 0)

compiled = transpile(qc, simulator)
result = simulator.run(compiled, shots=1000).result()
counts = result.get_counts()

print("Measurement of qubit 0:", counts)
print("If qubit 0 is measured as 0, qubit 1 collapses to |0>.")
print("If qubit 0 is measured as 1, qubit 1 collapses to |1>.")
print("Thus, the unmeasured qubit is perfectly correlated with qubit 0.")


