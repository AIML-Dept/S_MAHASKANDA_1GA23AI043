from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator
from qiskit.visualization import plot_histogram
import matplotlib.pyplot as plt

# Initialize the quantum simulator
backend = AerSimulator()

# Build a single-qubit circuit
coin_flip = QuantumCircuit(1, 1)

# Create an equal superposition
coin_flip.h(0)

# Measure the qubit
coin_flip.measure([0], [0])

# Execute the circuit
job = backend.run(coin_flip, shots=1024)
result = job.result()

# Retrieve the measurement results
outcomes = result.get_counts()

print("Quantum Coin Flip Results:")
print(outcomes)

# Display the circuit diagram
print("\nCircuit:")
print(coin_flip.draw(output="text"))

# Show the histogram
plot_histogram(outcomes)
plt.title("Quantum Coin Flip")
plt.show()
